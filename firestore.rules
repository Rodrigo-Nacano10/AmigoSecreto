rules_version = '2';

// Plano gratuito (Spark): sem Cloud Functions.
//
// grupos/{gid}                        → dados do grupo (público para leitura)
// grupos/{gid}/participantes/{uid}    → nome de quem entrou (público: "quem já entrou")
// grupos/{gid}/resultados/{uid}       → amigo secreto de cada um: SÓ o próprio dono lê
// grupos/{gid}/revelacao/pares        → todos os pares: só o anfitrião, e só no Dia da Revelação
// usuarios/{uid}/grupos/{gid}         → atalho "meus amigos secretos" (só o dono)

service cloud.firestore {
  match /databases/{database}/documents {

    function grupoPath(gid) { return /databases/$(database)/documents/grupos/$(gid); }
    function grupo(gid) { return get(grupoPath(gid)).data; }
    function logado() { return request.auth != null; }
    function souAnfitriao(gid) { return logado() && grupo(gid).hostUid == request.auth.uid; }
    function aberto(gid) { return grupo(gid).status == 'aberto'; }
    function texto(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    // gravação do sorteio: o grupo estava aberto e, no mesmo lote, passa para "sorteado"
    function sorteandoAgora(gid) {
      return souAnfitriao(gid) && aberto(gid) && getAfter(grupoPath(gid)).data.status == 'sorteado';
    }

    match /grupos/{gid} {
      allow read: if true;

      allow create: if logado()
        && request.resource.data.keys().hasOnly(['nome', 'data', 'valor', 'hostUid', 'status', 'criadoEm'])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.status == 'aberto'
        && texto(request.resource.data.nome, 1, 40)
        && texto(request.resource.data.data, 0, 10)
        && texto(request.resource.data.valor, 0, 30)
        && request.resource.data.criadoEm == request.time;

      allow update: if logado() && resource.data.hostUid == request.auth.uid && (
        // editar dados
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nome', 'data', 'valor'])
          && texto(request.resource.data.nome, 1, 40))
        // aberto → sorteado (só junto com a gravação dos resultados)
        || (resource.data.status == 'aberto' && request.resource.data.status == 'sorteado'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'sorteadoEm', 'total'])
          && existsAfter(/databases/$(database)/documents/grupos/$(gid)/revelacao/pares))
        // sorteado → revelacao (Dia da Revelação)
        || (resource.data.status == 'sorteado' && request.resource.data.status == 'revelacao'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']))
      );

      allow delete: if logado() && resource.data.hostUid == request.auth.uid && resource.data.status == 'aberto';

      match /participantes/{uid} {
        allow read: if true;
        allow create: if logado() && request.auth.uid == uid && aberto(gid)
          && request.resource.data.keys().hasOnly(['nome', 'criadoEm'])
          && texto(request.resource.data.nome, 1, 50)
          && request.resource.data.criadoEm == request.time;
        // marcar "já vi meu amigo secreto"
        allow update: if logado() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viu'])
          && request.resource.data.viu == true;
        // sair (a própria pessoa) ou remover (anfitrião), só antes do sorteio
        allow delete: if logado() && (request.auth.uid == uid || souAnfitriao(gid)) && aberto(gid);
      }

      match /resultados/{uid} {
        allow read: if logado() && request.auth.uid == uid;
        allow create: if sorteandoAgora(gid)
          && request.resource.data.keys().hasOnly(['amigo'])
          && texto(request.resource.data.amigo, 1, 50);
        // (sem exists() por participante: o lote do sorteio tem limite de 20 leituras nas regras)
        allow update, delete: if false;
      }

      match /revelacao/{doc} {
        allow read: if souAnfitriao(gid) && grupo(gid).status == 'revelacao';
        allow create: if doc == 'pares' && sorteandoAgora(gid)
          && request.resource.data.keys().hasOnly(['pares'])
          && request.resource.data.pares is list;
        allow update, delete: if false;
      }
    }

    match /usuarios/{uid}/grupos/{gid} {
      allow read, delete: if logado() && request.auth.uid == uid;
      allow create: if logado() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['entrouEm'])
        && request.resource.data.entrouEm == request.time;
    }
  }
}
